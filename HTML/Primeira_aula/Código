<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Formulario</title>
    <style>
        label{display:block; margin-botton: 15xp}
    </style>
</head>
<body>
    <form action=""; method="get">
        <label>Nome
            <input type="text" name="nome">
        </label>
        <label>E-gmail
            <input type="email" name="E-gmail"
            placeholder="Seu melhor email">
        </label>
        <label>Idade
            <input type="number" name="idade">
        </label>
        <label>Data de Nacimento
            <input type="date" name="data_nasc"><!--data de nascimento-->

        </label>
        <label>Arquivo
            <input type="file" name="arquivo">
        </label>
        <label>Gênero</label>
        <label>
            <input type="radio" name="genero" value="masculino">Masculino
        </label>
        <label>
            <input type="radio" name="genero" value="feminino">Feminino
        </label>
        <label>
            <input type="radio" name="genero" value="outros">Outros
        </label>
        <label> Esporte</label>
        <label>
            <input type="checkbox" name="esporte" value="ciclismo">Ciclismo
        </label>
        <label>
            <input type="checkbox" name="esporte" value="volei">Volei
        </label>
        <label>
            <input type="checkbox" name="esporte" value="futebol">Futebol
        </label>
        <label>UF
            
                <option5 value="DF">DF</option>
                <option value="GO">GO</option>
            
                <option value="MA">MA</option>
                <option value="PI">PI</option>
                
           
        </label>
        <label>Mensagem
            <textaarea name="Mensagem" rows="6"
            cols="60"></textaarea>
        </label>
        <button type="submit">Enviar</button>
    </form>

    
</body>
</html>
